<?xml version="1.0" encoding="utf-8"?>
<!--
    Lapisan depan ikon adaptif TimeCraft - jam dinding putih dengan jarum membentuk posisi
    "jam 10:10" (konvensi umum di ikon/logo jam, terlihat ramah seperti senyum) di atas latar
    koral (lihat ic_launcher_background.xml). Sengaja TANPA lencana/centang tambahan (beda dari
    versi sebelumnya yang punya lencana centang emas bulat di sudut) - Google Play menandai
    bentuk lingkaran+centang sebagai menyerupai lencana "terverifikasi"/penghargaan di bawah
    Metadata policy, walau tidak ada teks klaim apa pun; mencoba menaruh centang polos tanpa
    lingkaran di dekat tepi piringan jam juga tetap terlihat menabrak/tidak rapi secara visual.
    Jam dinding sendiri sudah cukup merepresentasikan inti aplikasi (kontrol waktu layar).
    Semua elemen berada dalam zona aman 66x66dp di tengah kanvas 108x108dp sesuai pedoman
    Adaptive Icon Android.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Piringan jam - lingkaran putih penuh -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M26,54 a28,28 0 1,0 56,0 a28,28 0 1,0 -56,0 Z" />

    <!-- Jarum pendek (jam), menunjuk ke arah "10" -->
    <path
        android:strokeColor="#E2623C"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:pathData="M54,54 L42.5,46" />

    <!-- Jarum panjang (menit), menunjuk ke arah "2" - bersama jarum jam membentuk pola 10:10 -->
    <path
        android:strokeColor="#E2623C"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:pathData="M54,54 L70.4,42.5" />

    <!-- Titik poros di tengah jam -->
    <path
        android:fillColor="#E2623C"
        android:pathData="M50,54 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0 Z" />
</vector>
